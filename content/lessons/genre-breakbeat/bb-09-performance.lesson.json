  "objectives": [
    {
      "ru": "Играть «big beat» вживую",
      "en": "Perform a big-beat style live"
    }
  ],
  "steps": [
    {
      "kind": "hardware",
      "text": {
        "ru": "Mute пэда вживую: [SHIFT] + [REVERSE] + пэд (красный). Повтор — вернуть.",
        "en": "Live pad mute: [SHIFT] + [REVERSE] + a pad (turns red). Repeat to bring it back."
      },
      "deviceHighlight": {
        "controls": [
          "SHIFT",
          "REVERSE"
        ]
      }
    },
    {
      "kind": "hardware",
      "text": {
        "ru": "EFFECT GRAB: удерживая [VALUE], нажми кнопку эффекта — он звучит, пока нажата.",
        "en": "EFFECT GRAB: hold [VALUE] and press an effect button — it sounds while held."
      },
      "deviceHighlight": {
        "controls": [
          "VALUE",
          "FILTER+DRIVE"
        ]
      }
    },
    {
      "kind": "hardware",
      "text": {
        "ru": "Ролл на снейре: [ROLL] + пэд, интервал — [SHIFT] + [ROLL].",
        "en": "A roll on the snare: [ROLL] + pad; the interval is [SHIFT] + [ROLL]."
      },
      "deviceHighlight": {
        "controls": [
          "ROLL",
          "SHIFT"
        ]
      },
      "tryIt": {
        "ru": "Исполни перед возвратом роллом снейра и фильтром.",
        "en": "Perform a snare roll and a filter before the return."
      }
    }
  ],
